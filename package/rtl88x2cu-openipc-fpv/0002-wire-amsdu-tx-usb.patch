+#ifdef CONFIG_TX_AMSDU
+/* Subset of check_amsdu() that is safe to call while holding pxmitpriv->lock.
+ *
+ * check_amsdu() itself calls rtw_get_stainfo(), which takes pstapriv->sta_hash_lock.
+ * Acquiring that under pxmitpriv->lock is a lock-order inversion and in practice throttled
+ * the whole TX engine to ~12 xmit-loop iterations/s (measured: only the pre-pass's own
+ * aggregates got out, ~240 kbps of a 28 Mbps stream). Everything check_amsdu() tests
+ * except that lookup is a plain read of pkt_attrib, so replicate those here. The skipped
+ * test is the per-STA WLAN_STA_AMSDU_DISABLE flag, which nothing in this driver sets. */
+static int amsdu_ok_locksafe(struct xmit_frame *pf)
+{
+	struct pkt_attrib *a;
+
+	if (!pf)
+		return 0;
+	a = &pf->attrib;
+
+	if (!a->qos_en)
+		return 0;
+	if (IS_MCAST(a->ra))
+		return 0;
+	/* EAPOL / ARP / 802.1X-over-LAN / DHCP must never be aggregated: the 4-way
+	 * handshake and address resolution have to keep their own MPDUs. */
+	if ((a->ether_type == 0x888e) || (a->ether_type == 0x0806)
+	    || (a->ether_type == 0x88b4) || (a->dhcp_pkt == 1))
+		return 0;
+	if ((a->encrypt == _WEP40_) || (a->encrypt == _WEP104_) || (a->encrypt == _TKIP_))
+		return 0;
+
+	return 1;
+}
