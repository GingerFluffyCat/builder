+#ifdef CONFIG_TX_AMSDU
+	/* Standalone A-MSDU pre-pass: pack two pending QoS data MSDUs into ONE MPDU (normal
+	 * ACK, NOT A-MPDU-gated -- with ampdu_en==0 IS_AMSDU_AMPDU_NOT_VALID is false, i.e.
+	 * "(0,x): AMPDU not enable, but AMSDU is valid to send"). Realtek only wired the
+	 * coalesce builder into the PCIe path, so on USB tx_amsdu was inert.
+	 *
+	 * This is the only aggregation available here: the peer is a userspace libusb station
+	 * that cannot emit a compressed BlockAck, so the AP's agg_enable_bitmap stays 0
+	 * permanently (80+ issue_addba_req, never established) and MAC efficiency sits near
+	 * 40% of PHY. A-MSDU needs no BlockAck.
+	 *
+	 * Three earlier attempts all regressed; keep this loop free of their mistakes:
+	 *   - Never hand-roll a single-frame send. v1 called rtw_dump_xframe() on a frame that
+	 *     had not been through rtw_xmitframe_coalesce(), so nr_frags was 0, the URB submit
+	 *     inside `for (t = 0; t < nr_frags; t++)` never ran, the xmit_buf was never
+	 *     returned -> leak -> 137x "xmit_status_check tx hang". v2 rebuilt the same path
+	 *     and it silently dropped ~92% of frames (4343 dequeued vs ~355 transmitted per
+	 *     10s, tx_dropped=0) -> black screen.
+	 *   - Never return _FALSE from here. The caller does `if (ret == _FALSE) break;`, which
+	 *     breaks the entire TX drain loop. v2 used that for a hold timer and throughput
+	 *     fell from 34 Mbps to 0.3-0.8 Mbps (proven by toggling tx_amsdu alone).
+	 *   - Never dequeue speculatively and put frames back. v3 did, and rtw_xmitframe_enqueue()
+	 *     appends at the TAIL, so an EAPOL frame could end up behind a re-enqueued data
+	 *     frame and the station stopped completing the 4-way handshake.
+	 *
+	 * rtw_dequeue_xframe_amsdu_pair() therefore decides and removes atomically under
+	 * pxmitpriv->lock: it yields two aggregatable frames or leaves the queue untouched. If
+	 * it yields nothing we simply fall through to the driver's own path below. */
+	if (pxmitbuf == NULL && check_amsdu_tx_support(padapter)
+	    && check_fwstate(&padapter->mlmepriv, WIFI_AP_STATE | WIFI_STATION_STATE)) {
+		struct xmit_frame *fa = NULL, *fb = NULL;
+
+		if (rtw_dequeue_xframe_amsdu_pair(pxmitpriv, &fa, &fb)) {
+			struct xmit_buf *abuf = rtw_alloc_xmitbuf(pxmitpriv);
+
+			if (abuf) {
+				/* fb is the primary: the A-MSDU is built into ITS buffer and fb is
+				 * what we dump. Mirror the normal first-frame setup --
+				 * coalesce_amsdu() derives
+				 * hw_hdr_offset = TXDESC_SIZE + pkt_offset*PACKET_OFFSET_SZ under
+				 * CONFIG_USB_TX_AGGREGATION and update_txdesc() uses pkt_offset to
+				 * decide whether to pull the txdesc head. Leaving these zero was
+				 * v1/v2 bug #2. */
+				fb->pxmitbuf = abuf;
+				fb->buf_addr = abuf->pbuf;
+				abuf->priv_data = fb;
+				fb->agg_num = 1;
+#ifdef CONFIG_TX_EARLY_MODE
+				fb->pkt_offset = (PACKET_OFFSET_SZ / 8) + 1;
+#else
+				fb->pkt_offset = (PACKET_OFFSET_SZ / 8);
+#endif
+				if (rtw_xmitframe_coalesce_amsdu(padapter, fb, fa) == _SUCCESS) {
+					/* Both OS packets are copied into abuf now. coalesce_amsdu()
+					 * sets pattrib->nr_frags = 1, which is why this path
+					 * actually transmits. */
+					rtw_os_xmit_complete(padapter, fa);
+					rtw_os_xmit_complete(padapter, fb);
+					/* fa's payload lives in fb's buffer and fa never owned an
+					 * xmit_buf: free the frame only. */
+					rtw_free_xmitframe(pxmitpriv, fa);
+					pxmitpriv->amsdu_debug_coalesce_two++;
+					rtw_dump_xframe(padapter, fb);
+					return _TRUE;
+				}
+				rtw_free_xmitbuf(pxmitpriv, abuf);
+				fb->pxmitbuf = NULL;
+				fb->buf_addr = NULL;
+			}
+			/* Only reachable if the xmitbuf pool is exhausted or the build failed --
+			 * not in steady state -- so this cannot reorder handshake traffic in
+			 * practice, and both frames are accounted for either way. */
+			rtw_xmitframe_enqueue(padapter, fa);
+			rtw_xmitframe_enqueue(padapter, fb);
+			pxmitpriv->amsdu_debug_coalesce_one++;
+		}
+	}
+#endif /* CONFIG_TX_AMSDU */
+
 	/* check xmitbuffer is ok */
 	if (pxmitbuf == NULL) {
 		pxmitbuf = rtw_alloc_xmitbuf(pxmitpriv);
