+				 * is why opportunistic pairing alone never fired (coalesce_two
+				 * stayed 0). Nothing is dequeued here so nothing can leak, and
+				 * the timeout handler does tasklet_hi_schedule(xmit_tasklet), so
+				 * a held frame is always re-driven. */
+				rtw_amsdu_set_timer_status(padapter, amsdu_prio,
+						RTW_AMSDU_TIMER_SETTING);
+				rtw_amsdu_set_timer(padapter, amsdu_prio);
+				pxmitpriv->amsdu_debug_set_timer++;
+				return _FALSE;
+			} else {
+				/* Timer already armed/fired: stop waiting, fall through to the
+				 * normal path and send this frame now. */
+				rtw_amsdu_set_timer_status(padapter, amsdu_prio,
+						RTW_AMSDU_TIMER_UNSET);
+				pxmitpriv->amsdu_debug_timeout++;
+			}
+		}
+	}
+#endif /* CONFIG_TX_AMSDU */
