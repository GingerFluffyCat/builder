+/* Atomically dequeue between 2 and maxn frames that can share ONE A-MSDU, or nothing.
+ *
+ * All candidates come from the same per-STA/per-AC servq, so the RA matches by
+ * construction and only the TID is compared. Deciding and removing together under
+ * pxmitpriv->lock means the queue is never left reordered -- putting frames back with
+ * rtw_xmitframe_enqueue() appends at the TAIL, which previously pushed an EAPOL frame
+ * behind data and stopped the station completing the 4-way handshake.
+ *
+ * Stops early when the accumulated A-MSDU would exceed maxlen (the peer advertises a
+ * 7935-byte maximum A-MSDU length in its HT capabilities).
+ *
+ * Returns the number of frames written to out[] (0, or >= 2). */
+int rtw_dequeue_xframe_amsdu_n(struct xmit_priv *pxmitpriv, struct xmit_frame **out,
+		int maxn, int maxlen)
+{
+	_irqL irqL0;
+	_list *sta_plist, *sta_phead, *fr_phead, *fr_plist;
+	struct hw_xmit *phwxmit_i = pxmitpriv->hwxmits;
+	struct hw_xmit *phwxmit;
+	struct tx_servq *ptxservq = NULL;
+	_queue *pframe_queue = NULL;
+	_adapter *padapter = pxmitpriv->adapter;
+	struct registry_priv *pregpriv = &padapter->registrypriv;
+	int i, got = 0;
+#ifdef CONFIG_RTW_MGMT_QUEUE
+	sint entry = pxmitpriv->hwxmit_entry - 1;
+#else
+	sint entry = pxmitpriv->hwxmit_entry;
+#endif
+
+	if (maxn < 2)
+		maxn = 2;
+	if (pregpriv->wifi_spec == 1)
+		return 0;
+
+	_enter_critical_bh(&pxmitpriv->lock, &irqL0);
+
+	for (i = 0; i < entry; i++) {
+		phwxmit = phwxmit_i + i;
+
+		sta_phead = get_list_head(phwxmit->sta_queue);
+		sta_plist = get_next(sta_phead);
+
+		while ((rtw_end_of_queue_search(sta_phead, sta_plist)) == _FALSE) {
+			ptxservq = LIST_CONTAINOR(sta_plist, struct tx_servq, tx_pending);
+			pframe_queue = &ptxservq->sta_pending;
+
+			if (ptxservq->qcnt >= 2) {
+				struct xmit_frame *cand[16];
+				int ncand = 0, total = 0, prio = -1;
+				int room = maxn > 16 ? 16 : maxn;
+
+				/* Walk the head of this servq WITHOUT touching the list. */
+				fr_phead = get_list_head(pframe_queue);
+				fr_plist = get_next(fr_phead);
+				while (ncand < room
+				       && rtw_end_of_queue_search(fr_phead, fr_plist) == _FALSE) {
+					struct xmit_frame *pf =
+						LIST_CONTAINOR(fr_plist, struct xmit_frame, list);
+					int sub;
+
+					if (!amsdu_ok_locksafe(pf))
+						break;
+					if (prio < 0)
+						prio = pf->attrib.priority;
+					else if (pf->attrib.priority != prio)
+						break;
+
+					/* subframe = [DA][SA][len] + LLC/SNAP + payload + pad */
+					sub = ETH_HLEN + 8 + pf->attrib.pktlen + 3;
+					if (ncand && (total + sub) > maxlen)
+						break;
+
+					total += sub;
+					cand[ncand++] = pf;
+					fr_plist = get_next(fr_plist);
+				}
+
+				if (ncand >= 2) {
+					int k;
+
+					for (k = 0; k < ncand; k++) {
+						rtw_list_delete(&cand[k]->list);
+						ptxservq->qcnt--;
+						phwxmit->accnt--;
+						out[k] = cand[k];
+					}
+					if (_rtw_queue_empty(pframe_queue))
+						rtw_list_delete(&ptxservq->tx_pending);
+					got = ncand;
+					goto exit;
+				}
+			}
+			sta_plist = get_next(sta_plist);
+		}
+	}
+
+exit:
+	_exit_critical_bh(&pxmitpriv->lock, &irqL0);
+	return got;
+}
+#endif /* CONFIG_TX_AMSDU */
