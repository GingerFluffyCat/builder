+#ifdef CONFIG_TX_AMSDU
+/* Atomically dequeue TWO frames that may share one A-MSDU, or dequeue NOTHING.
+ *
+ * Why this exists: the obvious implementation (dequeue one frame, look for a partner, put
+ * the frame back if there isn't one) reorders the queue, because rtw_xmitframe_enqueue()
+ * appends at the tail. On an AP that is fatal -- an EAPOL handshake frame can end up
+ * sequenced behind a re-enqueued data frame, and the station then never completes the
+ * 4-way. Doing the decision and the removal together under pxmitpriv->lock means the queue
+ * is only ever modified when we are certain, so frame order is preserved exactly.
+ *
+ * Both frames come from the SAME per-STA/per-AC servq, so the RA matches by construction;
+ * only the TID has to be compared (TIDs 0 and 3 both map to BE). check_amsdu() rejects
+ * EAPOL/ARP/DHCP/WEP/TKIP and multicast, so control-plane traffic is never aggregated.
+ *
+ * Returns 1 with *ppfa/*ppfb set (caller owns both frames), else 0 with both NULL. */
+int rtw_dequeue_xframe_amsdu_pair(struct xmit_priv *pxmitpriv,
+		struct xmit_frame **ppfa, struct xmit_frame **ppfb)
+{
+	_irqL irqL0;
+	_list *sta_plist, *sta_phead, *fr_phead, *fr_plist;
+	struct hw_xmit *phwxmit_i = pxmitpriv->hwxmits;
+	struct hw_xmit *phwxmit;
+	struct tx_servq *ptxservq = NULL;
+	_queue *pframe_queue = NULL;
+	struct xmit_frame *fa = NULL, *fb = NULL;
+	_adapter *padapter = pxmitpriv->adapter;
+	struct registry_priv *pregpriv = &padapter->registrypriv;
+	int i, got = 0;
+#ifdef CONFIG_RTW_MGMT_QUEUE
+	sint entry = pxmitpriv->hwxmit_entry - 1;
+#else
+	sint entry = pxmitpriv->hwxmit_entry;
+#endif
+
+	*ppfa = NULL;
+	*ppfb = NULL;
+
+	/* No A-MSDU when wifi_spec is on (matches rtw_get_xframe). */
+	if (pregpriv->wifi_spec == 1)
+		return 0;
+
+	_enter_critical_bh(&pxmitpriv->lock, &irqL0);
+
+	for (i = 0; i < entry; i++) {
+		phwxmit = phwxmit_i + i;
+
+		sta_phead = get_list_head(phwxmit->sta_queue);
+		sta_plist = get_next(sta_phead);
+
+		while ((rtw_end_of_queue_search(sta_phead, sta_plist)) == _FALSE) {
+			ptxservq = LIST_CONTAINOR(sta_plist, struct tx_servq, tx_pending);
+			pframe_queue = &ptxservq->sta_pending;
+
+			if (ptxservq->qcnt >= 2) {
+				/* Peek the two head frames without touching the list. */
+				fr_phead = get_list_head(pframe_queue);
+				fr_plist = get_next(fr_phead);
+				fa = LIST_CONTAINOR(fr_plist, struct xmit_frame, list);
+				fr_plist = get_next(fr_plist);
+				fb = LIST_CONTAINOR(fr_plist, struct xmit_frame, list);
+
+				if (fa && fb
+				    && check_amsdu(fa) == _TRUE && check_amsdu(fb) == _TRUE
+				    && fa->attrib.priority == fb->attrib.priority) {
+					/* Commit: remove both, in order. */
+					rtw_list_delete(&fa->list);
+					ptxservq->qcnt--;
+					phwxmit->accnt--;
+					rtw_list_delete(&fb->list);
+					ptxservq->qcnt--;
+					phwxmit->accnt--;
+
+					/* Drop the sta node once it has nothing pending (same
+					 * bookkeeping rtw_dequeue_xframe does). */
+					if (_rtw_queue_empty(pframe_queue))
+						rtw_list_delete(&ptxservq->tx_pending);
+
+					*ppfa = fa;
+					*ppfb = fb;
+					got = 1;
+					goto exit;
+				}
+				fa = NULL;
+				fb = NULL;
+			}
+			sta_plist = get_next(sta_plist);
+		}
+	}
+
+exit:
+	_exit_critical_bh(&pxmitpriv->lock, &irqL0);
+	return got;
+}
+#endif /* CONFIG_TX_AMSDU */
+
 struct xmit_frame *rtw_dequeue_xframe(struct xmit_priv *pxmitpriv, struct hw_xmit *phwxmit_i, sint entry)
 {
 	_irqL irqL0;
