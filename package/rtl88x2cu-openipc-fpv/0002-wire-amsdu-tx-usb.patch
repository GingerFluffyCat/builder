Wire standalone A-MSDU TX into the rtl8822cu USB xmit path (v3).

Realtek only wired the A-MSDU coalesce builder into the PCIe xmit path
(hal/*/pci/*ce_xmit.c). On USB it is dead code with no caller, so the `tx_amsdu`
proc knob is inert and the counters never move.

This matters on this AP because A-MPDU never engages at all: the station is a
userspace libusb driver that cannot emit a compressed BlockAck, so the AP's
per-STA agg_enable_bitmap stays 0 permanently (80+ issue_addba_req, never
established) and MAC efficiency sits near 40% of PHY. A-MSDU is the only
aggregation form that needs no BlockAck.

Two earlier attempts both destroyed throughput. Recorded here so neither is
reintroduced:

  v1 hand-rolled a "could not pair" send by calling rtw_dump_xframe() on a frame
  that had never been through rtw_xmitframe_coalesce(), leaving nr_frags and
  last_txcmdsz unset. rtw_dump_xframe() submits its URB *inside*
  `for (t = 0; t < nr_frags; t++)`, so nothing was written and the xmit_buf was
  never returned by the TX-complete callback -> leak -> pool exhaustion -> 137x
  "xmit_status_check tx hang" and STAs stopped associating.

  v2 fixed that leak (0 hangs) and achieved real pairing -- the receiver saw
  A-MSDUs with exactly 2 subframes each -- but still hand-rolled the single-frame
  send, which SILENTLY dropped ~92% of frames (4343 dequeued vs ~355 transmitted
  per 10s, tx_dropped=0, nothing in dmesg) giving 80% RTP loss and a black
  screen. v2 also returned _FALSE to implement a 1 ms hold timer, but the caller
  does `if (ret == _FALSE) break;`, which breaks the driver's entire TX drain
  loop. Toggling that one proc value on an otherwise identical module measured
  34 Mbps with the pre-pass off vs 0.3-0.8 Mbps with it on.

v3 therefore does exactly two things: it pairs (the only path ever proven to
transmit, because rtw_xmitframe_coalesce_amsdu() sets pattrib->nr_frags = 1), and
when it cannot pair it returns the frame with rtw_xmitframe_enqueue() and falls
through to the driver's own aggregation path. No hand-rolled send anywhere, and
the pre-pass never returns _FALSE. The hold timer is gone.

Also sets pkt_offset/agg_num before coalescing: coalesce_amsdu() derives
hw_hdr_offset = TXDESC_SIZE + pkt_offset*PACKET_OFFSET_SZ under
CONFIG_USB_TX_AGGREGATION, and update_txdesc() uses pkt_offset to decide whether
to pull the txdesc head. Both were left zero in v1/v2.

Pairing requires matching RA and TID. Same servq guarantees the RA, but TIDs 0
and 3 both map to BE, so both are checked; the PCIe reference omits this.

diff --git a/hal/rtl8822c/usb/rtl8822cu_xmit.c b/hal/rtl8822c/usb/rtl8822cu_xmit.c
--- a/hal/rtl8822c/usb/rtl8822cu_xmit.c
+++ b/hal/rtl8822c/usb/rtl8822cu_xmit.c
@@ -538,6 +538,115 @@
 	}
 #endif
 
+#ifdef CONFIG_TX_AMSDU
+	/* Standalone A-MSDU pre-pass: pack two pending QoS data MSDUs into ONE MPDU (normal
+	 * ACK, NOT A-MPDU-gated -- with ampdu_en==0 IS_AMSDU_AMPDU_NOT_VALID is false, i.e.
+	 * "(0,x): AMPDU not enable, but AMSDU is valid to send"). Realtek only wired the
+	 * coalesce builder into the PCIe path; on USB it is dead code, so tx_amsdu was inert.
+	 *
+	 * This matters here because A-MPDU never engages on this AP: the station is a
+	 * userspace libusb driver that cannot emit a compressed BlockAck, so the AP's
+	 * agg_enable_bitmap stays 0 forever (80+ issue_addba_req, never established) and MAC
+	 * efficiency is stuck near 40% of PHY. A-MSDU is the one aggregation form that needs
+	 * no BlockAck.
+	 *
+	 * TWO EARLIER ATTEMPTS BOTH KILLED THROUGHPUT -- do not reintroduce either:
+	 *
+	 *  v1 hand-rolled a "could not pair" send by calling rtw_dump_xframe() on a frame that
+	 *  had never been through rtw_xmitframe_coalesce(). nr_frags/last_txcmdsz and the
+	 *  txdesc were unset, and rtw_dump_xframe() submits its URB *inside*
+	 *  `for (t = 0; t < nr_frags; t++)`, so nothing was written and the xmit_buf was never
+	 *  returned by the TX-complete callback -> leak -> pool exhaustion -> 137x
+	 *  "xmit_status_check tx hang", STAs stopped associating.
+	 *
+	 *  v2 fixed the leak (0 hangs) and got real pairing (ground saw amsdu/sub with exactly
+	 *  2 subframes per MPDU), but still hand-rolled the single-frame send -- which SILENTLY
+	 *  dropped ~92% of frames (4343 dequeued vs ~355 transmitted per 10s, tx_dropped=0, no
+	 *  dmesg) -> 80% RTP loss -> black screen. v2 also returned _FALSE to implement a
+	 *  1 ms hold timer, and the caller does `if (ret == _FALSE) break;` -- that BREAKS the
+	 *  driver's entire TX drain loop. Measured by toggling this one proc value on an
+	 *  otherwise identical module: 34 Mbps with the pre-pass off, 0.3-0.8 Mbps with it on.
+	 *
+	 * So v3 does exactly two things: it pairs (the only path ever proven to transmit), and
+	 * when it cannot pair it puts the frame back with rtw_xmitframe_enqueue() and FALLS
+	 * THROUGH to the driver's own aggregation path below. No hand-rolled send, and never a
+	 * _FALSE return from the pre-pass. */
+	if (pxmitbuf == NULL && check_amsdu_tx_support(padapter)
+	    && check_fwstate(&padapter->mlmepriv, WIFI_AP_STATE | WIFI_STATION_STATE)) {
+		int amsdu_nf = 0;
+		struct xmit_frame *peek = rtw_get_xframe(pxmitpriv, &amsdu_nf);
+
+		/* rtw_get_xframe() peeks the head of the first non-empty per-STA/per-AC servq and
+		 * reports THAT queue's depth, so nf >= 2 means a same-STA same-AC partner exists. */
+		if (peek && amsdu_nf >= 2 && check_amsdu(peek)) {
+			struct xmit_frame *fa = rtw_dequeue_xframe(pxmitpriv,
+					pxmitpriv->hwxmits, pxmitpriv->hwxmit_entry);
+
+			if (fa) {
+				struct xmit_frame *fb = NULL;
+				int nf2 = 0;
+
+				/* All subframes of one A-MSDU must share RA and TID. Same servq
+				 * guarantees the RA, but TIDs 0 and 3 both map to BE, so check both.
+				 * (_rtw_memcmp returns _TRUE when equal.) */
+				peek = rtw_get_xframe(pxmitpriv, &nf2);
+				if (peek && check_amsdu(peek)
+				    && peek->attrib.priority == fa->attrib.priority
+				    && _rtw_memcmp(peek->attrib.ra, fa->attrib.ra, ETH_ALEN))
+					fb = rtw_dequeue_xframe(pxmitpriv, pxmitpriv->hwxmits,
+							pxmitpriv->hwxmit_entry);
+
+				if (fb) {
+					struct xmit_buf *abuf = rtw_alloc_xmitbuf(pxmitpriv);
+
+					if (abuf) {
+						/* fb is the primary: the A-MSDU is built into ITS buffer
+						 * and fb is what we dump. Mirror the normal first-frame
+						 * setup -- coalesce_amsdu() derives
+						 * hw_hdr_offset = TXDESC_SIZE + pkt_offset*PACKET_OFFSET_SZ
+						 * under CONFIG_USB_TX_AGGREGATION, and update_txdesc()
+						 * uses pkt_offset to decide whether to pull the txdesc
+						 * head. Leaving these unset was v1/v2 bug #2. */
+						fb->pxmitbuf = abuf;
+						fb->buf_addr = abuf->pbuf;
+						abuf->priv_data = fb;
+						fb->agg_num = 1;
+#ifdef CONFIG_TX_EARLY_MODE
+						fb->pkt_offset = (PACKET_OFFSET_SZ / 8) + 1;
+#else
+						fb->pkt_offset = (PACKET_OFFSET_SZ / 8);
+#endif
+						if (rtw_xmitframe_coalesce_amsdu(padapter, fb, fa)
+								== _SUCCESS) {
+							/* Both OS packets are copied into abuf now.
+							 * coalesce_amsdu() sets pattrib->nr_frags = 1,
+							 * which is why this path actually transmits. */
+							rtw_os_xmit_complete(padapter, fa);
+							rtw_os_xmit_complete(padapter, fb);
+							/* fa's payload lives in fb's buffer and fa never
+							 * owned an xmit_buf: free the frame only. */
+							rtw_free_xmitframe(pxmitpriv, fa);
+							pxmitpriv->amsdu_debug_coalesce_two++;
+							rtw_dump_xframe(padapter, fb);
+							return _TRUE;
+						}
+						rtw_free_xmitbuf(pxmitpriv, abuf);
+						fb->pxmitbuf = NULL;
+						fb->buf_addr = NULL;
+					}
+					/* Give fb back too; ordering shifts but nothing is lost. */
+					rtw_xmitframe_enqueue(padapter, fb);
+				}
+
+				/* Could not pair (or could not build): hand fa back to the driver's
+				 * own path rather than inventing a send for it. */
+				rtw_xmitframe_enqueue(padapter, fa);
+				pxmitpriv->amsdu_debug_coalesce_one++;
+			}
+		}
+	}
+#endif /* CONFIG_TX_AMSDU */
+
 	/* check xmitbuffer is ok */
 	if (pxmitbuf == NULL) {
 		pxmitbuf = rtw_alloc_xmitbuf(pxmitpriv);
